<Window x:Class="Sportly.DeleteUser"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Sportly"
        mc:Ignorable="d"
        Title="DeleteUser" Height="450" Width="800">
    <Grid>
        <Button x:Name="DeleteUser1" Content="Button" HorizontalAlignment="Left" Margin="314,320,0,0" VerticalAlignment="Top" Click="DeleteUser1_Click"/>
        <TextBox x:Name="email" HorizontalAlignment="Left" Margin="354,105,0,0" TextWrapping="Wrap" Text="" VerticalAlignment="Top" Width="120" TextChanged="email_TextChanged"/>
        <PasswordBox x:Name="password" HorizontalAlignment="Left" Margin="400,204,0,0"   VerticalAlignment="Top" Width="120"/>
        <TextBox x:Name="firstName" HorizontalAlignment="Left" Margin="145,105,0,0" TextWrapping="Wrap" Text="TextBox" VerticalAlignment="Top" Width="120"/>
        <TextBox x:Name="lastName" HorizontalAlignment="Left" Margin="145,148,0,0" TextWrapping="Wrap" Text="TextBox" VerticalAlignment="Top" Width="120"/>

    </Grid>
</Window>
