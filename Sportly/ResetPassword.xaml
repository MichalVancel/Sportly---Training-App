<Window x:Class="Sportly.ResetPassword"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Sportly"
        mc:Ignorable="d"
        Title="ResetPassword" Height="700" Width="800" 
        Background="#1C1C1C">
    <Grid  Background="#121212">
        <Grid.RowDefinitions>
            <RowDefinition Height="150"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>


        <Label Content="ZMENA HESLA" HorizontalAlignment="Center" VerticalAlignment="Center"  Grid.Row="0" FontFamily="Artifakt Element Heavy" FontSize="50" Foreground="#B22222"/>

        <Border Background="#B22222" Grid.Row="0" Height="60" Width="60" HorizontalAlignment="Left" Margin="34,45,0,45" CornerRadius="30">
            <Button Content="←" HorizontalAlignment="Center"  VerticalAlignment="Center" Grid.Row="0" Height="60"  Width="60" FontSize="70" Padding="0,-25,0,0" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Background="Transparent" Foreground="White" Click="BackButton_Click" BorderBrush ="Transparent"/>
        </Border>
        <StackPanel Grid.Row="1" VerticalAlignment="Center"  HorizontalAlignment="Center">

            <Border Background="#1E1E1E" BorderThickness="1" CornerRadius="25" BorderBrush="#333333"  Padding="50,40">

                <StackPanel>

                    <StackPanel Orientation="Horizontal" Margin="0,0,0,20">
                        <Label Content="Email" Width="150" Foreground="White" FontSize="22" 
                           FontFamily="Artifakt Element Heavy" VerticalAlignment="Center"/>
                        <TextBox x:Name="emailTextBox" Width="300" Height="40" Background="#2D2D2D" 
                             Foreground="White" VerticalContentAlignment="Center" FontSize="16" Padding="5,0"/>
                    </StackPanel>


                    <StackPanel Orientation="Horizontal">
                        <Label Content="Nové Heslo" Width="150" Foreground="White" FontSize="22" 
                           FontFamily="Artifakt Element Heavy" VerticalAlignment="Center"/>
                        <PasswordBox x:Name="newPasswordBox" Width="300" Height="40" Background="#2D2D2D" 
                                 Foreground="White" VerticalContentAlignment="Center" FontSize="16" Padding="5,0"/>
                    </StackPanel>
                </StackPanel>
            </Border>


            <Border Background="#B22222" CornerRadius="10" Margin="0,30,0,0" 
                HorizontalAlignment="Center" Width="250" Height="60">
                <Button x:Name="resetPasswordBuutton" Content="Zmeniť Heslo"   Click="resetPasswordBuutton_Click" Foreground="White"  Background="Transparent" BorderBrush="Transparent"   FontSize="18" FontFamily="Artifakt Element Heavy"  Width="250" Height="60" Cursor="Hand"/>
            </Border>
        </StackPanel>
    </Grid>
</Window>
