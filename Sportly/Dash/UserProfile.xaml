<Window x:Class="Sportly.Dash.UserProfile"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="UserProfile" Height="700" Width="800" Background="Black">
    <Grid Background="#121212">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="25,30,25,0">
            <Border Background="#B22222" Height="60" Width="60" HorizontalAlignment="Left" CornerRadius="30">
                <Button Content="←" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="70" Padding="0,-25,0,0" Background="Transparent" Foreground="White" Click="BackButton_Click" BorderBrush="Transparent"/>
            </Border>
            <Label Content="PROFIL" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#B22222" FontFamily="Artifakt Element Heavy" FontSize="50"/>
        </Grid>

       
        <StackPanel Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center">
            <Grid>
              
                <Border BorderBrush="#333333" BorderThickness="1" Background="#1E1E1E" CornerRadius="25" Width="650" Height="500"/>

              
                <StackPanel Margin="40">
                    <Grid Margin="0,10">
                        <Label Content="Meno" Foreground="White" FontSize="25" FontFamily="Artifakt Element Heavy"/>
                        <TextBlock x:Name="FirstNameBox" Margin="250,0,0,0" FontSize="25" Foreground="White" VerticalAlignment="Center"/>
                    </Grid>

                    <Grid Margin="0,10">
                        <Label Content="Priezvisko" Foreground="White" FontSize="25" FontFamily="Artifakt Element Heavy"/>
                        <TextBlock x:Name="LastNameBox" Margin="250,0,0,0" FontSize="25" Foreground="White" VerticalAlignment="Center"/>
                    </Grid>

                    <Grid Margin="0,10">
                        <Label Content="Dátum nar." Foreground="White" FontSize="25" FontFamily="Artifakt Element Heavy"/>
                        <TextBlock x:Name="DateOfBirthBox" Margin="250,0,0,0" FontSize="25" Foreground="White" VerticalAlignment="Center"/>
                    </Grid>

                    <Grid Margin="0,10">
                        <Label Content="Adresa" Foreground="White" FontSize="25" FontFamily="Artifakt Element Heavy"/>
                        <TextBlock x:Name="AddressBox" Margin="250,0,0,0" FontSize="25" Foreground="White" VerticalAlignment="Center"/>
                    </Grid>

                    <Grid Margin="0,10">
                        <Label Content="E-mail" Foreground="White" FontSize="25" FontFamily="Artifakt Element Heavy"/>
                        <TextBlock x:Name="EmailBox" Margin="250,0,0,0" FontSize="25" Foreground="White" VerticalAlignment="Center"/>
                    </Grid>

                    <Grid Margin="0,10">
                        <Label Content="Telefón" Foreground="White" FontSize="25" FontFamily="Artifakt Element Heavy"/>
                        <TextBlock x:Name="PhoneBox" Margin="250,0,0,0" FontSize="25" Foreground="White" VerticalAlignment="Center"/>
                    </Grid>

                    <Grid Margin="0,10">
                        <Label Content="Pohlavie" Foreground="White" FontSize="25" FontFamily="Artifakt Element Heavy"/>
                        <TextBlock x:Name="GenderBox" Margin="250,0,0,0" FontSize="25" Foreground="White" VerticalAlignment="Center"/>
                    </Grid>
                </StackPanel>
            </Grid>
        </StackPanel>
    </Grid>
</Window>