<Window x:Class="Sportly.Dash.DashBoard"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Sportly.Dash"
        mc:Ignorable="d"
        Title="DashBoard" Height="800" Width="1000" Background="White">
    <Grid Background="#121212">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="80"/>
        </Grid.RowDefinitions>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1*"/>
            <ColumnDefinition Width="1.2*"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Row="0" Grid.Column="0" 
        Background="#B22222" CornerRadius="25" 
        Margin="20,20,10,20" VerticalAlignment="Top" Height="250">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <Label x:Name="NameLabel" Content="" FontSize="25" Foreground="White" FontFamily="Artifakt Element Heavy"/>
                    <Label x:Name="SureNameLabel" Content="" FontSize="25" Foreground="White" FontFamily="Artifakt Element Heavy" Margin="5,0,0,0"/>
                </StackPanel>
                <Label x:Name="BirthDateLabel" Content="" FontSize="15" Foreground="White" HorizontalContentAlignment="Center"  FontFamily="Artifakt Element Heavy"/>
                <Label x:Name="TeamNameLabel" Content="" FontSize="15" Foreground="White" HorizontalContentAlignment="Center"/>
            </StackPanel>
        </Border>
        <Border Grid.Row="0" Grid.Column="1" 
        Background="#1E1E1E" BorderThickness="1" BorderBrush="#333333" 
        CornerRadius="25" Margin="10,20,20,20" Padding="15">

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="203*"/>
                    <RowDefinition Height="113*"/>
                </Grid.RowDefinitions>
                <Border Background="#B22222" CornerRadius="12" Height="53"  VerticalAlignment="Top" HorizontalAlignment="Right"  Margin="0,5,5,0" Width="150">
                    <Button x:Name="AddEventButton"  Content="Pridať Udalosť"  Background="Transparent" Foreground="White" FontFamily="Artifakt Element Heavy"  BorderBrush="Transparent"  Cursor="Hand" Click="AddEventButton_Click"/>
                </Border>

                <Border Background="#B22222" CornerRadius="12" Height="53"  VerticalAlignment="Top" HorizontalAlignment="Left"  Margin="0,5,323,0" Width="150">
                    <Button x:Name="RemoveEventButton"  Content="Odstrániť Udalosť"  Background="Transparent" Foreground="White" FontFamily="Artifakt Element Heavy"  BorderBrush="Transparent"  Cursor="Hand" Click="RemoveEventButton_Click"/>
                </Border>

                <Border  BorderThickness="0,0,0,1" 
                Height="1" VerticalAlignment="Top" Margin="0,65,0,0"/>

                <ListBox x:Name="Events" Background="Transparent"  BorderThickness="0" Foreground="White"  FontSize="20"  FontFamily="Artifakt Element Heavy"  Margin="0,75,0,0" HorizontalContentAlignment="Stretch"  ScrollViewer.HorizontalScrollBarVisibility="Disabled"  Grid.RowSpan="2" MouseDoubleClick="EventDetails_DoubleClick">

                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="BorderThickness" Value="0"/>
                            <Setter Property="Padding" Value="0"/>
                            <Setter Property="Margin" Value="0,0,0,10"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <!-- Tento Border rieši efekt kliknutia/označenia -->
                                        <Border x:Name="SelectionBorder"  Background="Transparent"   BorderBrush="Transparent"  BorderThickness="2"  CornerRadius="10">

                                            <ContentPresenter />
                                        </Border>

                                        <ControlTemplate.Triggers>
                                            <!-- Efekt pri kliknutí na udalosť -->
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="SelectionBorder" Property="BorderBrush" Value="White"/>
                                                <Setter TargetName="SelectionBorder" Property="Background" Value="#252526"/>
                                            </Trigger>
                                            <!-- Efekt pri prejdení myšou -->
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="SelectionBorder" Property="Background" Value="#1E1E1E"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>

                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border Background="#1C1C1E" CornerRadius="8" Padding="15">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Označenie či je to tréning/zápas -->
                                    <Border Grid.Column="0" Width="6" CornerRadius="3" Margin="0,0,15,0">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="#A2CC3A"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Typ}" Value="Zápas">
                                                        <Setter Property="Background" Value="#FF5252"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                    </Border>

                                    <!-- Hlavný obsah -->
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <WrapPanel Margin="0,0,0,5">
                                            <TextBlock Text="{Binding Typ}" Foreground="White" FontSize="20" FontWeight="SemiBold" />
                                            <TextBlock Text=" - " Foreground="White" FontSize="20" FontWeight="SemiBold" />
                                            <TextBlock Text="{Binding Kategoria}" Foreground="White" FontSize="20" FontWeight="SemiBold" />
                                            <TextBlock Text=" - " Foreground="White" FontSize="20" FontWeight="SemiBold" />
                                            <TextBlock Text="{Binding Miesto}" Foreground="White" FontSize="20" FontWeight="SemiBold" />
                                        </WrapPanel>

                                        <WrapPanel Margin="0,0,0,10">
                                            <TextBlock Text="{Binding Datum}" Foreground="#A0A0A0" FontSize="14" />
                                            <TextBlock Text=" " Foreground="#A0A0A0" FontSize="14" />
                                            <TextBlock Text="{Binding CasOd}" Foreground="#A0A0A0" FontSize="14" />
                                            <TextBlock Text=" - " Foreground="#A0A0A0" FontSize="14" />
                                            <TextBlock Text="{Binding CasDo}" Foreground="#A0A0A0" FontSize="14" />
                                            <TextBlock Text="  ·  " Foreground="#A0A0A0" FontSize="14" />
                                            <TextBlock Text="{Binding Miesto}" Foreground="#A0A0A0" FontSize="14" />
                                        </WrapPanel>

                                        <!-- Počet účastníkov -->
                                        <Border Background="Black" CornerRadius="6" HorizontalAlignment="Left" Padding="10,5">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="&#xE77B;" FontFamily="Segoe MDL2 Assets" Foreground="White" FontSize="12" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                                <TextBlock Text="{Binding PocetUcastnikov}" Foreground="White" FontSize="14" FontWeight="Bold" FontFamily="Segoe UI" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>

                                    <!-- Button účasti  -->
                                    <ToggleButton Grid.Column="2" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="10,0,0,0" Cursor="Hand" PreviewMouseLeftButtonDown="AttendanceToggleButton_PreviewMouseLeftButtonDown" IsChecked="{Binding Ucast, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
                                        <ToggleButton.Template>
                                            <ControlTemplate TargetType="ToggleButton">
                                                <Border x:Name="StateBorder" Width="32" Height="32" CornerRadius="16" Background="#333333">
                                                    <TextBlock x:Name="StateIcon" Text="&#xE11B;" FontFamily="Segoe MDL2 Assets" Foreground="White" FontSize="16" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsChecked" Value="True">
                                                        <Setter TargetName="StateBorder" Property="Background" Value="#1B4220"/>
                                                        <Setter TargetName="StateIcon" Property="Text" Value="&#xE73E;"/>
                                                        <Setter TargetName="StateIcon" Property="Foreground" Value="#4CAF50"/>
                                                    </Trigger>
                                                    <Trigger Property="IsChecked" Value="False">
                                                        <Setter TargetName="StateBorder" Property="Background" Value="#4A1C1C"/>
                                                        <Setter TargetName="StateIcon" Property="Text" Value="&#xE711;"/>
                                                        <Setter TargetName="StateIcon" Property="Foreground" Value="#FF5252"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </ToggleButton.Template>
                                    </ToggleButton>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>
        </Border>
        <Border BorderBrush="#333333" BorderThickness="1" Background="#1E1E1E" CornerRadius="25" Margin="20,296,10,20">

            <TextBlock Text="Zatial sa tu nenachádza žiadny sponzor" Foreground="White" Opacity="0.2"  FontSize="20"  FontFamily="Artifakt Element Heavy"  HorizontalAlignment="Center"  VerticalAlignment="Stretch" IsHitTestVisible="False" Height="44" />
        </Border>


        <Grid Grid.Row="1" Grid.ColumnSpan="2" Margin="30,0,30,10">
            <Border Background="#B22222" CornerRadius="12" HorizontalAlignment="Left" Width="302" Height="55" Margin="0,8,0,8">
                <Button Content="&#xF3B1;" FontSize="35" Background="Transparent" BorderBrush="Transparent" Foreground="White" FontFamily="Segoe MDL2 Assets" Click="LogOutButton_Click" />
            </Border> 



            <Border Background="#B22222" CornerRadius="12" HorizontalAlignment="Right" Width="302" Height="55">
                <Button Content="&#xE77B;" FontSize="30" Background="Transparent" BorderBrush="Transparent" Foreground="White" FontFamily="Segoe MDL2 Assets" Height="55" VerticalAlignment="Top" Click="UserInfoButton_Click"/>
            </Border>
        </Grid>

    </Grid>
</Window>