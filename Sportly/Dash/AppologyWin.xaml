<Window x:Class="Sportly.Dash.AppologyWin"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Sportly.Dash"
        mc:Ignorable="d"
        Title="AppologyWin" Height="550" Width="600"
         Background="#1C1C1C">
    <Grid Background="#121212">
        <StackPanel Margin="38,50,38,35">

            <Label Content="OSPRAVEDLNENKA" 
               HorizontalAlignment="Center" 
               Margin="0,0,0,20" 
               FontFamily="Artifakt Element Heavy" 
               FontSize="35" 
               Foreground="#B22222"/>

            <Border BorderBrush="#333333" 
                BorderThickness="1" 
                Background="#1E1E1E" 
                CornerRadius="25" 
                Padding="22">

                <StackPanel>
                    <Label Content="Sem napíš, prečo sa nemôžeš zúčastniť" 
                       HorizontalAlignment="Left" 
                       Foreground="White" 
                       FontSize="15" 
                       FontFamily="Artifakt Element Heavy"
                       Margin="22,0,0,0"/>

                    <TextBox x:Name="AppologyTextBox" 
                         Height="40" 
                         Background="#2D2D2D" 
                         Foreground="White" 
                         VerticalContentAlignment="Center" 
                         FontSize="16" 
                         Padding="5,0" 
                         Margin="22,20,22,20" 
                         TextChanged="AppologyTextBox_TextChanged"/>
                </StackPanel>
            </Border>

            <Border Background="#B22222" 
                CornerRadius="12" 
                Width="180" 
                Height="45" 
                HorizontalAlignment="Center"
                Margin="0,20,0,0">
                <Button Content="Potvrdiť" 
                    Width="180" 
                    Height="45" 
                    FontFamily="Artifakt Element Heavy" 
                    FontSize="14" 
                    Foreground="White" 
                    Background="Transparent" 
                    BorderBrush="Transparent" 
                    Click="ConfirmButton_Click"/>
            </Border>

        </StackPanel>
    </Grid>
</Window>
