<Window x:Class="Sportly.Dash.DetailWin"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Sportly.Dash"
        mc:Ignorable="d"
        Title="DetailWin" Height="550" Width="900">
    <Grid Background="#121212">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Label Content="DOCHÁDZKA" HorizontalAlignment="Center" Margin="0,49,0,0" Grid.Row="0" VerticalAlignment="Top" FontSize="40" FontFamily="Artifakt Element Heavy" Foreground="#B22222"/>

        <Border Background="#B22222" Grid.Row="0" Width="60" HorizontalAlignment="Left" Margin="48,49,0,21" CornerRadius="30">
            <Button Content="←" HorizontalAlignment="Center"  VerticalAlignment="Center" Grid.Row="0" Height="60"  Width="60" FontSize="70" Padding="0,-25,0,0" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Background="Transparent" Foreground="White" Click="BackButton_Click" BorderBrush ="Transparent"/>
        </Border>

        <Grid Grid.Row="1" Width="900" Height="455" HorizontalAlignment="Center" VerticalAlignment="Center">

            <Border BorderThickness="1" Background="#1E1E1E" BorderBrush="#333333" CornerRadius="25" Margin="26,17,26,99"/>

            <ListBox x:Name="Attendance" Margin="43,35,43,112" Background="Transparent" BorderBrush="Transparent" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Border BorderBrush="#333333" BorderThickness="0,0,0,1" Margin="5" Padding="10">
                            <StackPanel>
                                <Grid Width="750">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{Binding FirstName}" FontSize="24" FontWeight="SemiBold" Foreground="White" Margin="0,0,10,0"/>
                                    <TextBlock Grid.Column="1" Text="{Binding LastName}" FontSize="24" FontWeight="SemiBold" Foreground="White" />
                                    
                                    <Border Grid.Column="3" Width="40" Height="40" CornerRadius="20" Background="{Binding SymbolBackground}">
                                        <TextBlock Text="{Binding AttendingSymbol}" FontFamily="Segoe MDL2 Assets" Foreground="{Binding SymbolForeground}" FontSize="20" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                </Grid>
                                
                                <TextBlock Text="{Binding ApologyText}" FontSize="16" Foreground="#A0A0A0" Margin="0,5,0,0" TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

        </Grid>
    </Grid>
</Window>